 "changes": [
  {
   "file": "trinet/configuration_trinet.py",
   "old": "    model_type = \"trinet\"\n",
   "new": "    model_type = \"trinet\"\n    attribute_map = {\"num_hidden_layers\": \"n_layers\"}\n",
   "count": 1,
   "why": "transformers 5.x builds a cache in generate() from config.num_hidden_layers; TriNet's config calls it n_layers, so generate() failed with AttributeError."
  },
  {
   "file": "trinet/modeling_trinet.py",
   "old": "            except TypeError:\n",
   "new": "            except (TypeError, ValueError):\n",
   "count": 1,
   "why": "transformers 5.x's Cache() with no arguments raises ValueError, not TypeError, so the guard around it did not catch it."
  },
  {
   "file": "trinet/modeling_trinet.py",
   "old": "seen_tokens",
   "new": "_seen_tokens",
   "count": 4,
   "why": "transformers 4.x's Cache has a read-only property seen_tokens, so TriNetCache could not set it (AttributeError); the count is kept under _seen_tokens, the name that property reads."
  }
 ]
